# config.yaml.example
# このファイルを config.yaml にコピーして使用してください。
# 環境変数より config.yaml の値が優先されます。

# Telos上の一意なエージェントID
monad_id: monad-my-domain

# メインループの実行間隔（秒）
interval_sec: 180

# LiteLLM形式のモデルID（例: openai/gpt-4o-mini, anthropic/claude-3-haiku）
llm_model: openai/gpt-4o-mini

# Process型Monadのシードクエリ（fetch型では無視されます）
seed_query: "feedback between scales"
